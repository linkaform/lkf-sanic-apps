# Plantilla del catalogo de cuentas.
#
# Copiala a secrets/accounts.ini y llena tus credenciales. Ese archivo NO se versiona:
# secrets/ va por lista blanca en .gitignore y el hook pre-commit lo bloquea.
#
# Mientras dura la migracion, secrets/accounts.ini de este repo es un symlink al
# catalogo de ~/lkf/addons/secrets/accounts.ini, para no mantener dos copias de los
# mismos secretos. Cuando addons se retire, reemplazalo por un archivo real basado en
# esta plantilla (y borra la linea del volumen en docker/docker-compose.yml).
#
# La cuenta activa se elige con:   ./lkf workwith <domain_name>
# y queda guardada en:             secrets/current_domain
#
# Toda llave de una seccion se sube a `config` en MAYUSCULAS (username -> USERNAME), asi
# que para agregar una nueva basta ponerla aqui. Las unicas que no viajan a `config` son
# branch_name y account_id.

[global]
# Secretos compartidos por todas las cuentas.
couch_user           =
couch_password       =
couch_dev_user       =
couch_dev_password   =
openai_api_key       =

# El nombre de la seccion es el domain_name: lo que tecleas en `workwith <domain_name>`,
# y tambien el nombre de la rama en el submodulo app/modules.
[mi_dominio]
username             = usuario@ejemplo.com
apikey               =
# Opcionales:
# couch_user         =
# couch_password     =
# openrouter_api_key =
#
# branch_name: SOLO si la rama de app/modules no se llama como la seccion. Normalmente
# no hace falta: si la rama no existe, `workwith` la crea desde origin/master con el
# nombre de la seccion.
# branch_name        = otra_rama
#
# account_id: informativo para humanos. El real lo deriva el login (uts.update_settings).
# account_id         = 1234
